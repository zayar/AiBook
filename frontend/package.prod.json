{
  "name": "aibook-frontend",
  "version": "1.0.0",
  "description": "AI-Powered Financial Intelligence Platform - Production Build",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "NODE_ENV=production next build",
    "start": "next start",
    "start:prod": "NODE_ENV=production next start -p 3001",
    "lint": "next lint --fix",
    "lint:prod": "next lint --fix --quiet",
    "analyze": "ANALYZE=true npm run build",
    "export": "next export",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out node_modules/.cache",
    "optimize": "npm run clean && npm run build:prod && npm run analyze"
  },
  "dependencies": {
    "next": "15.4.4",
    "react": "^18",
    "react-dom": "^18",
    "framer-motion": "^10.16.5",
    "lucide-react": "^0.263.1",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@next/bundle-analyzer": "^15.4.4",
    "eslint": "^8",
    "eslint-config-next": "15.4.4",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}