model PaymentReceived {
  id                  String                @id @default(cuid())
  paymentNumber       String                @unique
  customerId          String?
  customerName        String?               // Allow manual customer name entry
  tenantId            String
  branchId            String?               // For multi-branch support
  
  // Payment Details
  amount              Decimal               @db.Decimal(15, 2)
  currency            String                @default("MMK")
  exchangeRate        Decimal               @default(1.000000) @db.Decimal(10, 6)
  paymentDate         DateTime              @default(now())
  paymentMode         PaymentReceivedMode   @default(CASH)
  depositType         DepositType           @default(CASH_IN_HAND)
  
  // Bank Details (if applicable)
  bankCharges         Decimal?              @db.Decimal(15, 2)
  referenceNumber     String?
  
  // Tax Information
  taxDeducted         Boolean               @default(false)
  taxAmount           Decimal?              @db.Decimal(15, 2)
  
  // Status and Workflow
  status              PaymentReceivedStatus @default(COMPLETED)
  
  // Accounting
  isReconciled        Boolean               @default(false)
  reconciledAt        DateTime?
  reconciledBy        String?
  
  // Additional Information
  notes               String?               @db.Text
  internalNotes       String?               @db.Text
  attachments         Json?                 // Store file metadata
  
  // Email notification
  sendThankYouEmail   Boolean               @default(false)
  emailSent           Boolean               @default(false)
  emailSentAt         DateTime?
  
  // Audit fields
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  createdBy           String?
  updatedBy           String?
  
  // Relations
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer?             @relation(fields: [customerId], references: [id])
  invoicePayments     InvoicePayment[]      // Link to invoices this payment applies to
  journalEntries      Entry[]               @relation("PaymentReceivedJournalEntries")
  
  @@unique([tenantId, paymentNumber])
  @@index([tenantId, status])
  @@index([tenantId, paymentDate])
  @@index([tenantId, customerId])
  @@index([tenantId, paymentMode])
  @@map("payments_received")
}


