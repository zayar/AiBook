}

model AIModelPerformance {
  id                 String   @id @default(cuid())
  modelType          String
  tenantId           String
  accuracy           Float
  precision          Float
  recall             Float
  f1Score            Float
  timesSaved         Int
  errorsDetected     Int
  revenueImpact      Decimal? @db.Decimal(15, 2)
  trainingDataPoints Int
  lastTrainingDate   DateTime
  improvementRate    Float
  period             DateTime
  createdAt          DateTime @default(now())
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, modelType])
  @@index([tenantId, period])
  @@map("ai_model_performances")
}

model BusinessInsight {
  id              String          @id @default(cuid())
  tenantId        String
  type            InsightType
  category        String
  priority        InsightPriority
  confidence      Float
  title           String
  description     String
  actionable      Boolean         @default(false)
  recommendations Json
  potentialImpact Decimal?        @db.Decimal(15, 2)
  timeframe       String?
  effort          String?
  dataPoints      Json
  relatedEntities Json
  viewed          Boolean         @default(false)
  viewedAt        DateTime?
  actionTaken     String?
  userFeedback    Json?
  isActive        Boolean         @default(true)
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
  @@index([tenantId, priority])
  @@index([tenantId, isActive])
  @@index([tenantId, createdAt])
  @@map("business_insights")
}

model FinancialKPI {
  id                   String   @id @default(cuid())
  tenantId             String
  name                 String
  category             String
  calculation          Json
  currentValue         Decimal  @db.Decimal(15, 2)
  previousValue        Decimal? @db.Decimal(15, 2)
  targetValue          Decimal? @db.Decimal(15, 2)
  benchmarkValue       Decimal? @db.Decimal(15, 2)
  trend                String
  changePercent        Float?
  predictedValue       Decimal? @db.Decimal(15, 2)
  predictionConfidence Float?
  period               DateTime
  createdAt            DateTime @default(now())
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([tenantId, period])
  @@index([tenantId, name])
  @@map("financial_kpis")
}

model AuditLog {
  id                  String               @id @default(cuid())
  entityType          String
  entityId            String
  action              String
  userId              String
  userEmail           String?
  oldValues           String?
  newValues           String?
  changes             String?
  ipAddress           String?
  userAgent           String?
  sessionId           String?
  reason              String?
  tenantId            String
  timestamp           DateTime             @default(now())
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criticalActionLog   CriticalActionLog?
  financialAuditTrail FinancialAuditTrail?

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, action])
  @@index([tenantId, userId])
  @@index([tenantId, timestamp])
  @@index([tenantId, ipAddress])
  @@map("audit_logs")
}

model FinancialAuditTrail {
  id               String   @id @default(cuid())
  auditLogId       String   @unique
  transactionType  String
  transactionId    String
  amount           Decimal? @db.Decimal(15, 2)
  currency         String   @default("MMK")
  accountsAffected String?
  tenantId         String
  auditLog         AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade)

  @@index([tenantId, transactionType])
  @@index([tenantId, transactionId])
  @@index([auditLogId], map: "financial_audit_trail_auditLogId_fkey")
  @@map("financial_audit_trail")
}

model CriticalActionLog {
  id         String   @id @default(cuid())
  auditLogId String   @unique
  action     String
  entityType String
  entityId   String
  userId     String
  alertSent  Boolean  @default(false)
  tenantId   String
  auditLog   AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade)

  @@index([tenantId, action])
  @@index([tenantId, alertSent])
  @@index([auditLogId], map: "critical_action_logs_auditLogId_fkey")
  @@map("critical_action_logs")
}

