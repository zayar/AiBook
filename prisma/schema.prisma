generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  domain               String?               @unique
  baseCurrency         Currency              @default(MMK)
  settings             Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accounts             Account[]
  bankAccounts         BankAccount[]
  bankReconciliations  BankReconciliation[]
  bankTransactions     BankTransaction[]
  bills                Bill[]
  books                Book[]
  customers            Customer[]
  entries              Entry[]
  expenses             Expense[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryItems       InventoryItem[]
  invoices             Invoice[]
  paymentMethods       PaymentMethod[]
  paymentsReceived     PaymentReceived[]
  purchases            Purchase[]
  reconciliations      Reconciliation[]
  salesOrders          SalesOrder[]
  salespeople          Salesperson[]
  taxCalculations      TaxCalculation[]
  taxRates             TaxRate[]
  vendorPayments       VendorPayment[]
  vendors              Vendor[]
  
  // AI-Enhanced relationships
  aiInsights           AIInsight[]
  businessPatterns     BusinessPattern[]
  aiModels             AIModel[]
  conversationHistory  ConversationHistory[]
  predictionCache      PredictionCache[]

  @@map("tenants")
}

model Book {
  id        String    @id @default(cuid())
  name      String
  currency  String    @default("USD")
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@unique([tenantId, name])
  @@map("books")
}

model Account {
  id                        String            @id @default(cuid())
  code                      String
  name                      String
  type                      AccountType
  currency                  String            @default("USD")
  balance                   Decimal           @default(0.00000000) @db.Decimal(20, 8)
  parentId                  String?
  bookId                    String
  tenantId                  String
  isActive                  Boolean           @default(true)
  description               String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  book                      Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parent                    Account?          @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                  Account[]         @relation("AccountHierarchy")
  tenant                    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccounts              BankAccount[]
  bankTransactions          BankTransaction[] @relation("BankTransactionContraAccount")
  entries                   Entry[]
  expenseAccounts           Expense[]         @relation("ExpenseAccount")
  inventoryAssets           InventoryItem[]   @relation("InventoryAsset")
  inventoryCOGS             InventoryItem[]   @relation("InventoryCOGS")
  taxRates                  TaxRate[]

  @@unique([tenantId, code])
  @@unique([tenantId, bookId, code])
  @@index([tenantId, type])
  @@index([tenantId, name])
  @@index([bookId], map: "accounts_bookId_fkey")
  @@index([parentId], map: "accounts_parentId_fkey")
  @@map("accounts")
}

model Entry {
  id                   String                @id @default(cuid())
  accountId            String
  bookId               String
  tenantId             String
  amount               Decimal               @db.Decimal(20, 8)
  currency             String                @default("USD")
  exchangeRate         Decimal               @default(1.00000000) @db.Decimal(20, 8)
  type                 EntryType
  memo                 String?
  reference            String?
  metadata             Json?
  journalId            String
  postedAt             DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  paymentReceivedId    String?
  
  // AI-Enhanced fields
  aiTags               Json?                 // Semantic tags as JSON array: ['recurring', 'seasonal', 'anomaly']
  embedding            Bytes?                // Vector embedding for semantic search
  confidence           Float?                // AI confidence in categorization
  aiInsights           Json?                 // Structured AI insights
  
  bankTransactions     BankTransaction[]
  account              Account               @relation(fields: [accountId], references: [id])
  book                 Book                  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  paymentReceived      PaymentReceived?      @relation("PaymentReceivedJournalEntries", fields: [paymentReceivedId], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryAdjustments InventoryAdjustment[]

  @@index([tenantId, journalId])
  @@index([tenantId, accountId])
  @@index([tenantId, postedAt])
  @@index([accountId], map: "entries_accountId_fkey")
  @@index([bookId], map: "entries_bookId_fkey")
  @@index([paymentReceivedId], map: "entries_paymentReceivedId_fkey")
  @@map("entries")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  firebaseUid String   @unique
  name        String?
  role        UserRole @default(USER)
  tenantId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("users")
}

model TransactionCategory {
  id          String                @id @default(cuid())
  name        String
  description String?
  parentId    String?
  tenantId    String
  confidence  Float?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  parent      TransactionCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    TransactionCategory[] @relation("CategoryHierarchy")

  @@unique([tenantId, name])
  @@index([parentId], map: "transaction_categories_parentId_fkey")
  @@map("transaction_categories")
}

model Customer {
  id               String            @id @default(cuid())
  name             String
  email            String?
  phone            String?
  address          Json?
  taxId            String?
  paymentTerms     Int               @default(30)
  creditLimit      Decimal?          @db.Decimal(15, 2)
  tenantId         String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses         Expense[]
  invoices         Invoice[]
  paymentsReceived PaymentReceived[]
  salesOrders      SalesOrder[]

  @@unique([tenantId, email])
  @@index([tenantId, name])
  @@map("customers")
}

model Vendor {
  id              String                @id @default(cuid())
  name            String
  email           String?
  phone           String?
  taxId           String?
  paymentTerms    PaymentTerms          @default(DUE_ON_RECEIPT)
  tenantId        String
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  billingAddress  Json?
  companyId       String?
  currency        String                @default("MMK")
  displayName     String?
  enablePortal    Boolean               @default(false)
  openingBalance  Decimal?              @db.Decimal(15, 2)
  portalLanguage  String                @default("English")
  primaryContact  Json?
  shippingAddress Json?
  taxRate         String?
  website         String?
  remarks         String?
  bills           Bill[]
  expenses        Expense[]
  purchases       Purchase[]
  contactPersons  VendorContactPerson[]
  documents       VendorDocument[]
  vendorPayments  VendorPayment[]
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, name])
  @@index([tenantId, isActive])
  @@map("vendors")
}

model VendorContactPerson {
  id          String   @id @default(cuid())
  vendorId    String
  salutation  String?
  firstName   String
  lastName    String
  email       String?
  workPhone   String?
  mobile      String?
  department  String?
  designation String?
  isPrimary   Boolean  @default(false)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, email])
  @@index([vendorId])
  @@map("vendor_contact_persons")
}

model VendorDocument {
  id          String   @id @default(cuid())
  vendorId    String
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  description String?
  tenantId    String
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_documents")
}

model Salesperson {
  id          String       @id @default(cuid())
  name        String
  email       String?
  phone       String?
  department  String?
  position    String?
  commission  Decimal?     @db.Decimal(5, 4)
  target      Decimal?     @db.Decimal(15, 2)
  territory   String?
  manager     String?
  tenantId    String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invoices    Invoice[]
  salesOrders SalesOrder[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, name])
  @@index([tenantId, isActive])
  @@map("salespeople")
}

model Invoice {
  id                String           @id @default(cuid())
  invoiceNumber     String
  customerId        String
  tenantId          String
  issueDate         DateTime         @default(now())
  dueDate           DateTime
  subtotal          Decimal          @db.Decimal(15, 2)
  taxAmount         Decimal          @default(0.00) @db.Decimal(15, 2)
  discountAmount    Decimal          @default(0.00) @db.Decimal(15, 2)
  totalAmount       Decimal          @db.Decimal(15, 2)
  paidAmount        Decimal          @default(0.00) @db.Decimal(15, 2)
  status            InvoiceStatus    @default(DRAFT)
  currency          String           @default("USD")
  exchangeRate      Decimal          @default(1.000000) @db.Decimal(10, 6)
  notes             String?
  termsConditions   String?
  recurring         Boolean          @default(false)
  recurringInterval String?
  salesOrderId      String?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  salespersonId     String?
  items             InvoiceItem[]
  payments          InvoicePayment[]
  customer          Customer         @relation(fields: [customerId], references: [id])
  salesOrder        SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  salesperson       Salesperson?     @relation(fields: [salespersonId], references: [id])
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([customerId], map: "invoices_customerId_fkey")
  @@index([salespersonId], map: "invoices_salespersonId_fkey")
  @@index([salesOrderId], map: "invoices_salesOrderId_fkey")
  @@map("invoices")
}

model InvoiceItem {
  id              String         @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Decimal        @db.Decimal(10, 3)
  unitPrice       Decimal        @db.Decimal(15, 2)
  totalPrice      Decimal        @db.Decimal(15, 2)
  taxRate         Decimal        @default(0.0000) @db.Decimal(5, 4)
  accountCode     String?
  tenantId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([invoiceId], map: "invoice_items_invoiceId_fkey")
  @@index([inventoryItemId], map: "invoice_items_inventoryItemId_fkey")
  @@map("invoice_items")
}

model InvoicePayment {
  id                  String           @id @default(cuid())
  invoiceId           String
  amount              Decimal          @db.Decimal(15, 2)
  paymentDate         DateTime         @default(now())
  paymentMethod       String?
  reference           String?
  notes               String?
  tenantId            String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  amountAllocated     Decimal?         @db.Decimal(15, 2)
  paymentReceivedId   String?
  invoice             Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentMethodRecord PaymentMethod?   @relation(fields: [paymentMethod], references: [id])
  paymentReceived     PaymentReceived? @relation(fields: [paymentReceivedId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([tenantId, paymentReceivedId])
  @@index([invoiceId], map: "invoice_payments_invoiceId_fkey")
  @@index([paymentMethod], map: "invoice_payments_paymentMethod_fkey")
  @@index([paymentReceivedId], map: "invoice_payments_paymentReceivedId_fkey")
  @@map("invoice_payments")
}

model PaymentMethod {
  id                  String               @id @default(cuid())
  name                String
  type                String
  accountNumber       String?
  routingNumber       String?
  bankName            String?
  bankIdentifierCode  String?
  currency            String               @default("MMK")
  branch              String?
  description         String?
  isDefault           Boolean              @default(false)
  isActive            Boolean              @default(true)
  tenantId            String
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bankReconciliations BankReconciliation[]
  bankTransactions    BankTransaction[]
  expenses            Expense[]            @relation("PaidThroughPaymentMethod")
  payments            InvoicePayment[]
  vendorPayments      VendorPayment[]      @relation("VendorPaymentPaidThrough")
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, accountNumber])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, type])
  @@map("payment_methods")
}

model SalesOrder {
  id            String           @id @default(cuid())
  orderNumber   String
  customerId    String
  tenantId      String
  orderDate     DateTime         @default(now())
  deliveryDate  DateTime?
  subtotal      Decimal          @db.Decimal(15, 2)
  taxAmount     Decimal          @default(0.00) @db.Decimal(15, 2)
  totalAmount   Decimal          @db.Decimal(15, 2)
  status        SalesOrderStatus @default(PENDING)
  currency      String           @default("USD")
  exchangeRate  Decimal          @default(1.000000) @db.Decimal(10, 6)
  notes         String?
  approvedBy    String?
  approvedAt    DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  salespersonId String?
  invoices      Invoice[]
  items         SalesOrderItem[]
  customer      Customer         @relation(fields: [customerId], references: [id])
  salesperson   Salesperson?     @relation(fields: [salespersonId], references: [id])
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([customerId], map: "sales_orders_customerId_fkey")
  @@index([salespersonId], map: "sales_orders_salespersonId_fkey")
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  description  String
  quantity     Decimal    @db.Decimal(10, 3)
  unitPrice    Decimal    @db.Decimal(15, 2)
  totalPrice   Decimal    @db.Decimal(15, 2)
  fulfilledQty Decimal    @default(0.000) @db.Decimal(10, 3)
  status       String     @default("pending")
  tenantId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, salesOrderId])
  @@index([salesOrderId], map: "sales_order_items_salesOrderId_fkey")
  @@map("sales_order_items")
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String
  vendorId       String?
  tenantId       String
  purchaseDate   DateTime       @default(now())
  deliveryDate   DateTime?
  subtotal       Decimal        @db.Decimal(15, 2)
  taxAmount      Decimal        @default(0.00) @db.Decimal(15, 2)
  totalAmount    Decimal        @db.Decimal(15, 2)
  status         PurchaseStatus @default(PENDING)
  currency       String         @default("USD")
  exchangeRate   Decimal        @default(1.000000) @db.Decimal(10, 6)
  notes          String?
  approvedBy     String?
  approvedAt     DateTime?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bills          Bill[]
  items          PurchaseItem[]
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor         Vendor?        @relation(fields: [vendorId], references: [id])

  @@unique([tenantId, purchaseNumber])
  @@index([tenantId, status])
  @@index([vendorId], map: "purchases_vendorId_fkey")
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  description String
  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(15, 2)
  totalPrice  Decimal  @db.Decimal(15, 2)
  receivedQty Decimal  @default(0.000) @db.Decimal(10, 3)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([tenantId, purchaseId])
  @@index([purchaseId], map: "purchase_items_purchaseId_fkey")
  @@map("purchase_items")
}

model Bill {
  id           String        @id @default(cuid())
  billNumber   String
  vendorId     String
  purchaseId   String?
  tenantId     String
  billDate     DateTime      @default(now())
  dueDate      DateTime
  subtotal     Decimal       @db.Decimal(15, 2)
  taxAmount    Decimal       @default(0.00) @db.Decimal(15, 2)
  totalAmount  Decimal       @db.Decimal(15, 2)
  paidAmount   Decimal       @default(0.00) @db.Decimal(15, 2)
  status       BillStatus    @default(PENDING)
  currency     String        @default("USD")
  exchangeRate Decimal       @default(1.000000) @db.Decimal(10, 6)
  notes        String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        BillItem[]
  payments     BillPayment[]
  purchase     Purchase?     @relation(fields: [purchaseId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor       Vendor        @relation(fields: [vendorId], references: [id])

  @@unique([tenantId, billNumber])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([purchaseId], map: "bills_purchaseId_fkey")
  @@index([vendorId], map: "bills_vendorId_fkey")
  @@map("bills")
}

model BillItem {
  id              String         @id @default(cuid())
  billId          String
  description     String
  quantity        Decimal        @db.Decimal(10, 3)
  unitPrice       Decimal        @db.Decimal(15, 2)
  totalPrice      Decimal        @db.Decimal(15, 2)
  taxRate         Decimal        @default(0.0000) @db.Decimal(5, 4)
  accountCode     String?
  tenantId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  inventoryItemId String?
  bill            Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([tenantId, billId])
  @@index([billId], map: "bill_items_billId_fkey")
  @@index([inventoryItemId], map: "bill_items_inventoryItemId_fkey")
  @@map("bill_items")
}

model BillPayment {
  id              String         @id @default(cuid())
  billId          String
  amount          Decimal        @db.Decimal(15, 2)
  paymentDate     DateTime       @default(now())
  paymentMethod   String
  reference       String?
  notes           String?
  tenantId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  vendorPaymentId String?
  bill            Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  vendorPayment   VendorPayment? @relation("VendorPaymentBillPayments", fields: [vendorPaymentId], references: [id])

  @@index([tenantId, billId])
  @@index([billId], map: "bill_payments_billId_fkey")
  @@index([vendorPaymentId])
  @@map("bill_payments")
}

model Expense {
  id               String        @id @default(cuid())
  description      String
  amount           Decimal       @db.Decimal(15, 2)
  expenseDate      DateTime      @default(now())
  category         String
  subcategory      String?
  receiptUrl       String?
  billable         Boolean       @default(false)
  customerId       String?
  projectId        String?
  status           ExpenseStatus @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  tenantId         String
  userId           String
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  branch           String?
  currency         String        @default("MMK")
  exchangeRate     Decimal       @default(1.0000) @db.Decimal(10, 4)
  expenseAccountId String
  expenseNumber    String        @unique
  journalId        String?
  notes            String?
  paidAt           DateTime?
  paidThroughId    String
  receiptFiles     Json?
  reference        String?
  taxAmount        Decimal       @default(0.00) @db.Decimal(15, 2)
  taxRateId        String?
  totalAmount      Decimal       @db.Decimal(15, 2)
  vendorId         String?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  expenseAccount   Account       @relation("ExpenseAccount", fields: [expenseAccountId], references: [id])
  paidThrough      PaymentMethod @relation("PaidThroughPaymentMethod", fields: [paidThroughId], references: [id])
  taxRate          TaxRate?      @relation(fields: [taxRateId], references: [id])
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor           Vendor?       @relation(fields: [vendorId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, expenseDate])
  @@index([tenantId, expenseNumber])
  @@index([customerId], map: "expenses_customerId_fkey")
  @@index([vendorId], map: "expenses_vendorId_fkey")
  @@index([taxRateId], map: "expenses_taxRateId_fkey")
  @@index([expenseAccountId], map: "expenses_expenseAccountId_fkey")
  @@index([paidThroughId], map: "expenses_paidThroughId_fkey")
  @@map("expenses")
}

model BankAccount {
  id              String            @id @default(cuid())
  name            String
  accountNumber   String
  routingNumber   String?
  bankName        String
  accountType     BankAccountType
  currency        String            @default("USD")
  balance         Decimal           @db.Decimal(15, 2)
  accountId       String
  tenantId        String
  isActive        Boolean           @default(true)
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  account         Account           @relation(fields: [accountId], references: [id])
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions    BankTransaction[]
  reconciliations Reconciliation[]

  @@unique([tenantId, accountNumber])
  @@index([tenantId, accountType])
  @@index([accountId], map: "bank_accounts_accountId_fkey")
  @@map("bank_accounts")
}

model BankTransaction {
  id                String          @id @default(cuid())
  bankAccountId     String?
  description       String
  amount            Decimal         @db.Decimal(15, 2)
  transactionDate   DateTime
  type              TransactionType
  reference         String?
  balance           Decimal?        @db.Decimal(15, 2)
  category          String?
  matched           Boolean         @default(false)
  entryId           String?
  tenantId          String
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paymentMethodId   String?
  reconciled        Boolean         @default(false)
  reconciledAt      DateTime?
  status            String          @default("pending")
  bankFee           Decimal?        @db.Decimal(15, 2)
  contraAccountId   String?
  creditAmount      Decimal?        @db.Decimal(15, 2)
  debitAmount       Decimal?        @db.Decimal(15, 2)
  exchangeRate      Decimal?        @db.Decimal(10, 6)
  runningBalance    Decimal         @db.Decimal(15, 2)
  statementDate     DateTime?
  transactionNumber String?
  bankAccount       BankAccount?    @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  contraAccount     Account?        @relation("BankTransactionContraAccount", fields: [contraAccountId], references: [id])
  entry             Entry?          @relation(fields: [entryId], references: [id])
  paymentMethod     PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, bankAccountId])
  @@index([tenantId, paymentMethodId])
  @@index([tenantId, transactionDate])
  @@index([tenantId, matched])
  @@index([tenantId, reconciled])
  @@index([tenantId, status])
  @@index([tenantId, runningBalance])
  @@index([tenantId, transactionNumber])
  @@index([bankAccountId], map: "bank_transactions_bankAccountId_fkey")
  @@index([paymentMethodId], map: "bank_transactions_paymentMethodId_fkey")
  @@index([entryId], map: "bank_transactions_entryId_fkey")
  @@index([contraAccountId], map: "bank_transactions_contraAccountId_fkey")
  @@map("bank_transactions")
}

model Reconciliation {
  id               String               @id @default(cuid())
  bankAccountId    String
  periodStart      DateTime
  periodEnd        DateTime
  statementBalance Decimal              @db.Decimal(15, 2)
  bookBalance      Decimal              @db.Decimal(15, 2)
  difference       Decimal              @db.Decimal(15, 2)
  status           ReconciliationStatus @default(IN_PROGRESS)
  reconciledBy     String?
  reconciledAt     DateTime?
  notes            String?
  tenantId         String
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  bankAccount      BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, bankAccountId])
  @@index([tenantId, status])
  @@index([bankAccountId], map: "reconciliations_bankAccountId_fkey")
  @@map("reconciliations")
}

model BankReconciliation {
  id                     String               @id @default(cuid())
  paymentMethodId        String
  reconciliationDate     DateTime
  statementBalance       Decimal              @db.Decimal(15, 2)
  bookBalance            Decimal?             @db.Decimal(15, 2)
  difference             Decimal?             @db.Decimal(15, 2)
  reconciledTransactions Int                  @default(0)
  status                 ReconciliationStatus @default(IN_PROGRESS)
  reconciledBy           String?
  notes                  String?
  tenantId               String
  metadata               Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  paymentMethod          PaymentMethod        @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentMethodId])
  @@index([tenantId, status])
  @@index([tenantId, reconciliationDate])
  @@index([paymentMethodId], map: "bank_reconciliations_paymentMethodId_fkey")
  @@map("bank_reconciliations")
}

model InventoryItem {
  id              String                @id @default(cuid())
  sku             String
  name            String
  description     String?
  category        String?
  unitOfMeasure   String                @default("each")
  unitCost        Decimal               @db.Decimal(15, 2)
  unitPrice       Decimal               @db.Decimal(15, 2)
  quantityOnHand  Decimal               @default(0.000) @db.Decimal(10, 3)
  reorderLevel    Decimal?              @db.Decimal(10, 3)
  reorderQuantity Decimal?              @db.Decimal(10, 3)
  assetAccountId  String
  cogsAccountId   String
  isActive        Boolean               @default(true)
  tenantId        String
  metadata        Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  billItems       BillItem[]
  adjustments     InventoryAdjustment[]
  assetAccount    Account               @relation("InventoryAsset", fields: [assetAccountId], references: [id])
  cogsAccount     Account               @relation("InventoryCOGS", fields: [cogsAccountId], references: [id])
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceItems    InvoiceItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, category])
  @@index([assetAccountId], map: "inventory_items_assetAccountId_fkey")
  @@index([cogsAccountId], map: "inventory_items_cogsAccountId_fkey")
  @@map("inventory_items")
}

model InventoryAdjustment {
  id             String         @id @default(cuid())
  itemId         String
  adjustmentType AdjustmentType
  quantity       Decimal        @db.Decimal(10, 3)
  unitCost       Decimal        @db.Decimal(15, 2)
  totalValue     Decimal        @db.Decimal(15, 2)
  reason         String
  reference      String?
  adjustedBy     String
  tenantId       String
  notes          String?
  entryId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  entry          Entry?         @relation(fields: [entryId], references: [id])
  item           InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, itemId])
  @@index([tenantId, adjustmentType])
  @@index([entryId], map: "inventory_adjustments_entryId_fkey")
  @@index([itemId], map: "inventory_adjustments_itemId_fkey")
  @@map("inventory_adjustments")
}

model TaxRate {
  id            String           @id @default(cuid())
  name          String
  rate          Decimal          @db.Decimal(8, 5)
  jurisdiction  String
  taxType       TaxType
  accountId     String
  effectiveDate DateTime
  expiryDate    DateTime?
  isActive      Boolean          @default(true)
  tenantId      String
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  expenses      Expense[]
  calculations  TaxCalculation[]
  account       Account          @relation(fields: [accountId], references: [id])
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, jurisdiction])
  @@index([tenantId, taxType])
  @@index([accountId], map: "tax_rates_accountId_fkey")
  @@map("tax_rates")
}

model TaxCalculation {
  id            String   @id @default(cuid())
  documentType  String
  documentId    String
  taxRateId     String
  taxableAmount Decimal  @db.Decimal(15, 2)
  taxAmount     Decimal  @db.Decimal(15, 2)
  tenantId      String
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  taxRate       TaxRate  @relation(fields: [taxRateId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentType, documentId])
  @@index([taxRateId], map: "tax_calculations_taxRateId_fkey")
  @@map("tax_calculations")
}

model PaymentReceived {
  id                String                @id @default(cuid())
  paymentNumber     String                @unique
  customerId        String?
  customerName      String?
  tenantId          String
  branchId          String?
  amount            Decimal               @db.Decimal(15, 2)
  currency          String                @default("MMK")
  exchangeRate      Decimal               @default(1.000000) @db.Decimal(10, 6)
  paymentDate       DateTime              @default(now())
  paymentMode       PaymentReceivedMode   @default(CASH)
  depositType       DepositType           @default(CASH_IN_HAND)
  bankCharges       Decimal?              @db.Decimal(15, 2)
  referenceNumber   String?
  taxDeducted       Boolean               @default(false)
  taxAmount         Decimal?              @db.Decimal(15, 2)
  status            PaymentReceivedStatus @default(COMPLETED)
  isReconciled      Boolean               @default(false)
  reconciledAt      DateTime?
  reconciledBy      String?
  notes             String?               @db.Text
  internalNotes     String?               @db.Text
  attachments       Json?
  sendThankYouEmail Boolean               @default(false)
  emailSent         Boolean               @default(false)
  emailSentAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdBy         String?
  updatedBy         String?
  journalEntries    Entry[]               @relation("PaymentReceivedJournalEntries")
  invoicePayments   InvoicePayment[]
  customer          Customer?             @relation(fields: [customerId], references: [id])
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, status])
  @@index([tenantId, paymentDate])
  @@index([tenantId, customerId])
  @@index([tenantId, paymentMode])
  @@index([customerId], map: "payments_received_customerId_fkey")
  @@map("payments_received")
}

model VendorPayment {
  id              String              @id @default(cuid())
  paymentNumber   String              @unique
  vendorId        String
  tenantId        String
  branchId        String?
  amount          Decimal             @db.Decimal(15, 2)
  bankCharges     Decimal             @default(0.00) @db.Decimal(15, 2)
  taxAmount       Decimal             @default(0.00) @db.Decimal(15, 2)
  currency        String              @default("MMK")
  exchangeRate    Decimal             @default(1.000000) @db.Decimal(10, 6)
  paymentDate     DateTime            @default(now())
  paymentMode     PaymentReceivedMode @default(CASH)
  paidThroughId   String
  referenceNumber String?
  taxDeducted     Boolean             @default(false)
  notes           String?             @db.Text
  internalNotes   String?             @db.Text
  attachments     Json?
  branch          String?             @default("Head Office")
  journalId       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdBy       String?
  updatedBy       String?
  billPayments    BillPayment[]       @relation("VendorPaymentBillPayments")
  paidThrough     PaymentMethod       @relation("VendorPaymentPaidThrough", fields: [paidThroughId], references: [id])
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor          Vendor              @relation(fields: [vendorId], references: [id])

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, vendorId])
  @@index([tenantId, paymentDate])
  @@index([tenantId, paymentMode])
  @@index([paidThroughId], map: "vendor_payments_paidThroughId_fkey")
  @@index([vendorId], map: "vendor_payments_vendorId_fkey")
  @@map("vendor_payments")
}

