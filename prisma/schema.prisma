generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SystemAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("system_admins")
}

model Tenant {
  id                    String                 @id @default(cuid())
  name                  String
  domain                String?                @unique
  industry              String?
  location              String?
  logo                  String?
  fiscalYearStart       Int                    @default(1)
  fiscalYearEnd         Int                    @default(12)
  fiscalYearStartDay    Int                    @default(1)
  reportBasis           ReportBasis            @default(ACCRUAL)
  language              String                 @default("English")
  timezone              String                 @default("Asia/Rangoon")
  dateFormat            String                 @default("dd MMM yyyy")
  companyId             String?
  settings              Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  baseCurrency          Currency               @default(MMK)
  accounts              Account[]
  aiInsights            AIInsight[]
  aiModelPerformances   AIModelPerformance[]
  aiModels              AIModel[]
  auditLogs             AuditLog[]
  bankAccounts          BankAccount[]
  bankReconciliations   BankReconciliation[]
  bankStatements        BankStatement[]
  bankTransactions      BankTransaction[]
  bills                 Bill[]
  books                 Book[]
  businessContexts      BusinessContext[]
  businessInsights      BusinessInsight[]
  businessPatterns      BusinessPattern[]
  cogsCalculations      COGSCalculation[]
  cogsLayerConsumptions COGSLayerConsumption[]
  conversationHistory   ConversationHistory[]
  conversationSessions  ConversationSession[]
  customers             Customer[]
  entries               Entry[]
  expenses              Expense[]
  financialKPIs         FinancialKPI[]
  inventoryAdjustments  InventoryAdjustment[]
  inventoryCostLayers   InventoryCostLayer[]
  inventoryItems        InventoryItem[]
  invoices              Invoice[]
  paymentMethods        PaymentMethod[]
  paymentsReceived      PaymentReceived[]
  predictionCache       PredictionCache[]
  purchases             Purchase[]
  reconciliations       Reconciliation[]
  reportTemplates       ReportTemplate[]
  salesOrders           SalesOrder[]
  salespeople           Salesperson[]
  taxCalculations       TaxCalculation[]
  taxRates              TaxRate[]
  transactionMatches    TransactionMatch[]
  userPreferences       UserPreference[]
  vendorPayments        VendorPayment[]
  vendors               Vendor[]

  @@map("tenants")
}

model Book {
  id        String    @id @default(cuid())
  name      String
  currency  String    @default("USD")
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("books")
}

model Account {
  id                        String            @id @default(cuid())
  code                      String
  name                      String
  type                      AccountType
  currency                  String            @default("USD")
  balance                   Decimal           @default(0.00000000) @db.Decimal(20, 8)
  parentId                  String?
  bookId                    String
  tenantId                  String
  isActive                  Boolean           @default(true)
  description               String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  book                      Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parent                    Account?          @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                  Account[]         @relation("AccountHierarchy")
  tenant                    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccounts              BankAccount[]
  bankTransactions          BankTransaction[] @relation("BankTransactionContraAccount")
  entries                   Entry[]
  expenseAccounts           Expense[]         @relation("ExpenseAccount")
  expensesPaidThrough       Expense[]         @relation("ExpensePaidThroughAccount")
  inventoryAssets           InventoryItem[]   @relation("InventoryAsset")
  inventoryCOGS             InventoryItem[]   @relation("InventoryCOGS")
  paymentsReceivedDeposits  PaymentReceived[] @relation("PaymentReceivedDepositAccount")
  taxRates                  TaxRate[]
  vendorPaymentsPaidThrough VendorPayment[]   @relation("VendorPaymentPaidThroughAccount")
  paymentMethods            PaymentMethod[]   @relation("PaymentMethodChartAccount")

  @@unique([tenantId, code])
  @@unique([tenantId, bookId, code])
  @@index([tenantId, type])
  @@index([tenantId, name])
  @@index([bookId], map: "accounts_bookId_fkey")
  @@index([parentId], map: "accounts_parentId_fkey")
  @@map("accounts")
}

model Entry {
  id                   String                @id @default(cuid())
  accountId            String
  bookId               String
  tenantId             String
  amount               Decimal               @db.Decimal(20, 8)
  currency             String                @default("USD")
  exchangeRate         Decimal               @default(1.00000000) @db.Decimal(20, 8)
  type                 EntryType
  memo                 String?
  reference            String?
  metadata             Json?
  journalId            String
  postedAt             DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  paymentReceivedId    String?
  aiInsights           Json?
  aiTags               Json?
  confidence           Float?
  embedding            Bytes?
  businessContextId    String?
  predictiveFactors    Json?
  semanticCategories   Json?
  relationshipGraph    Json?
  impactScore          Float?
  riskScore            Float?
  seasonalityFactors   Json?
  userBehaviorContext  Json?
  automationLevel      AutomationLevel       @default(MANUAL)
  learningFeedback     Json?
  bankTransactions     BankTransaction[]
  account              Account               @relation(fields: [accountId], references: [id])
  book                 Book                  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  businessContext      BusinessContext?      @relation(fields: [businessContextId], references: [id])
  paymentReceived      PaymentReceived?      @relation("PaymentReceivedJournalEntries", fields: [paymentReceivedId], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryAdjustments InventoryAdjustment[]

  @@index([tenantId, journalId])
  @@index([tenantId, accountId])
  @@index([tenantId, postedAt])
  @@index([tenantId, automationLevel])
  @@index([tenantId, impactScore])
  @@index([tenantId, riskScore])
  @@index([accountId], map: "entries_accountId_fkey")
  @@index([bookId], map: "entries_bookId_fkey")
  @@index([paymentReceivedId], map: "entries_paymentReceivedId_fkey")
  @@index([businessContextId], map: "entries_businessContextId_fkey")
  @@map("entries")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  firebaseUid        String   @unique
  name               String?
  role               UserRole @default(USER)
  tenantId           String?
  isActive           Boolean  @default(true)
  passwordHash       String?
  passwordMustChange Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@map("users")
}

model TransactionCategory {
  id          String                @id @default(cuid())
  name        String
  description String?
  parentId    String?
  tenantId    String
  confidence  Float?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  parent      TransactionCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    TransactionCategory[] @relation("CategoryHierarchy")

  @@unique([tenantId, name])
  @@index([parentId], map: "transaction_categories_parentId_fkey")
  @@map("transaction_categories")
}

model Customer {
  id               String            @id @default(cuid())
  name             String
  email            String?
  phone            String?
  address          Json?
  taxId            String?
  paymentTerms     Int               @default(30)
  creditLimit      Decimal?          @db.Decimal(15, 2)
  tenantId         String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses         Expense[]
  invoices         Invoice[]
  paymentsReceived PaymentReceived[]
  salesOrders      SalesOrder[]

  @@unique([tenantId, email])
  @@index([tenantId, name])
  @@map("customers")
}

model Vendor {
  id              String                @id @default(cuid())
  name            String
  email           String?
  phone           String?
  taxId           String?
  paymentTerms    PaymentTerms          @default(DUE_ON_RECEIPT)
  tenantId        String
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  billingAddress  Json?
  companyId       String?
  currency        String                @default("MMK")
  displayName     String?
  enablePortal    Boolean               @default(false)
  openingBalance  Decimal?              @db.Decimal(15, 2)
  portalLanguage  String                @default("English")
  primaryContact  Json?
  shippingAddress Json?
  taxRate         String?
  website         String?
  remarks         String?
  bills           Bill[]
  expenses        Expense[]
  purchases       Purchase[]
  contactPersons  VendorContactPerson[]
  documents       VendorDocument[]
  vendorPayments  VendorPayment[]
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, name])
  @@index([tenantId, isActive])
  @@map("vendors")
}

model VendorContactPerson {
  id          String   @id @default(cuid())
  vendorId    String
  salutation  String?
  firstName   String
  lastName    String
  email       String?
  workPhone   String?
  mobile      String?
  department  String?
  designation String?
  isPrimary   Boolean  @default(false)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, email])
  @@index([vendorId])
  @@map("vendor_contact_persons")
}

model VendorDocument {
  id          String   @id @default(cuid())
  vendorId    String
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  description String?
  tenantId    String
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_documents")
}

model Salesperson {
  id          String       @id @default(cuid())
  name        String
  email       String?
  phone       String?
  department  String?
  position    String?
  commission  Decimal?     @db.Decimal(5, 4)
  target      Decimal?     @db.Decimal(15, 2)
  territory   String?
  manager     String?
  tenantId    String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invoices    Invoice[]
  salesOrders SalesOrder[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, name])
  @@index([tenantId, isActive])
  @@map("salespeople")
}

model Invoice {
  id                String           @id @default(cuid())
  invoiceNumber     String
  customerId        String
  tenantId          String
  issueDate         DateTime         @default(now())
  dueDate           DateTime
  subtotal          Decimal          @db.Decimal(15, 2)
  taxAmount         Decimal          @default(0.00) @db.Decimal(15, 2)
  discountAmount    Decimal          @default(0.00) @db.Decimal(15, 2)
  totalAmount       Decimal          @db.Decimal(15, 2)
  paidAmount        Decimal          @default(0.00) @db.Decimal(15, 2)
  status            InvoiceStatus    @default(DRAFT)
  currency          String           @default("USD")
  exchangeRate      Decimal          @default(1.000000) @db.Decimal(10, 6)
  notes             String?
  termsConditions   String?
  recurring         Boolean          @default(false)
  recurringInterval String?
  salesOrderId      String?
  metadata          Json?
  shareToken        String?          @unique
  shareExpiresAt    DateTime?
  designSettings    Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  salespersonId     String?
  items             InvoiceItem[]
  payments          InvoicePayment[]
  customer          Customer         @relation(fields: [customerId], references: [id])
  salesOrder        SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  salesperson       Salesperson?     @relation(fields: [salespersonId], references: [id])
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([customerId], map: "invoices_customerId_fkey")
  @@index([salespersonId], map: "invoices_salespersonId_fkey")
  @@index([salesOrderId], map: "invoices_salesOrderId_fkey")
  @@map("invoices")
}

model InvoiceItem {
  id              String           @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Decimal          @db.Decimal(10, 3)
  unitPrice       Decimal          @db.Decimal(15, 2)
  totalPrice      Decimal          @db.Decimal(15, 2)
  taxRate         Decimal          @default(0.0000) @db.Decimal(5, 4)
  accountCode     String?
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  inventoryItemId String?
  cogsCalculation COGSCalculation? @relation("InvoiceItemCOGS")
  inventoryItem   InventoryItem?   @relation(fields: [inventoryItemId], references: [id])
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([invoiceId], map: "invoice_items_invoiceId_fkey")
  @@index([inventoryItemId], map: "invoice_items_inventoryItemId_fkey")
  @@map("invoice_items")
}

model InvoicePayment {
  id                  String           @id @default(cuid())
  invoiceId           String
  amount              Decimal          @db.Decimal(15, 2)
  paymentDate         DateTime         @default(now())
  paymentMethod       String?
  reference           String?
  notes               String?
  tenantId            String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  amountAllocated     Decimal?         @db.Decimal(15, 2)
  paymentReceivedId   String?
  invoice             Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentMethodRecord PaymentMethod?   @relation(fields: [paymentMethod], references: [id])
  paymentReceived     PaymentReceived? @relation(fields: [paymentReceivedId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([tenantId, paymentReceivedId])
  @@index([invoiceId], map: "invoice_payments_invoiceId_fkey")
  @@index([paymentMethod], map: "invoice_payments_paymentMethod_fkey")
  @@index([paymentReceivedId], map: "invoice_payments_paymentReceivedId_fkey")
  @@map("invoice_payments")
}

model PaymentMethod {
  id                  String               @id @default(cuid())
  name                String
  type                String
  accountNumber       String?
  routingNumber       String?
  bankName            String?
  bankIdentifierCode  String?
  currency            String               @default("MMK")
  branch              String?
  description         String?
  isDefault           Boolean              @default(false)
  isActive            Boolean              @default(true)
  tenantId            String
  chartAccountId      String?             // Link to chart of accounts
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bankReconciliations BankReconciliation[]
  bankStatements      BankStatement[]
  bankTransactions    BankTransaction[]
  expenses            Expense[]            @relation("PaidThroughPaymentMethod")
  payments            InvoicePayment[]
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorPayments      VendorPayment[]      @relation("VendorPaymentPaidThrough")
  chartAccount        Account?             @relation("PaymentMethodChartAccount", fields: [chartAccountId], references: [id])

  @@unique([tenantId, accountNumber])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, type])
  @@index([chartAccountId])
  @@map("payment_methods")
}

model SalesOrder {
  id            String           @id @default(cuid())
  orderNumber   String
  customerId    String
  tenantId      String
  orderDate     DateTime         @default(now())
  deliveryDate  DateTime?
  subtotal      Decimal          @db.Decimal(15, 2)
  taxAmount     Decimal          @default(0.00) @db.Decimal(15, 2)
  totalAmount   Decimal          @db.Decimal(15, 2)
  status        SalesOrderStatus @default(PENDING)
  currency      String           @default("USD")
  exchangeRate  Decimal          @default(1.000000) @db.Decimal(10, 6)
  notes         String?
  approvedBy    String?
  approvedAt    DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  salespersonId String?
  invoices      Invoice[]
  items         SalesOrderItem[]
  customer      Customer         @relation(fields: [customerId], references: [id])
  salesperson   Salesperson?     @relation(fields: [salespersonId], references: [id])
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([customerId], map: "sales_orders_customerId_fkey")
  @@index([salespersonId], map: "sales_orders_salespersonId_fkey")
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  description  String
  quantity     Decimal    @db.Decimal(10, 3)
  unitPrice    Decimal    @db.Decimal(15, 2)
  totalPrice   Decimal    @db.Decimal(15, 2)
  fulfilledQty Decimal    @default(0.000) @db.Decimal(10, 3)
  status       String     @default("pending")
  tenantId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, salesOrderId])
  @@index([salesOrderId], map: "sales_order_items_salesOrderId_fkey")
  @@map("sales_order_items")
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String
  vendorId       String?
  tenantId       String
  purchaseDate   DateTime       @default(now())
  deliveryDate   DateTime?
  subtotal       Decimal        @db.Decimal(15, 2)
  taxAmount      Decimal        @default(0.00) @db.Decimal(15, 2)
  totalAmount    Decimal        @db.Decimal(15, 2)
  status         PurchaseStatus @default(PENDING)
  currency       String         @default("USD")
  exchangeRate   Decimal        @default(1.000000) @db.Decimal(10, 6)
  notes          String?
  approvedBy     String?
  approvedAt     DateTime?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bills          Bill[]
  items          PurchaseItem[]
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor         Vendor?        @relation(fields: [vendorId], references: [id])

  @@unique([tenantId, purchaseNumber])
  @@index([tenantId, status])
  @@index([vendorId], map: "purchases_vendorId_fkey")
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  description String
  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(15, 2)
  totalPrice  Decimal  @db.Decimal(15, 2)
  receivedQty Decimal  @default(0.000) @db.Decimal(10, 3)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([tenantId, purchaseId])
  @@index([purchaseId], map: "purchase_items_purchaseId_fkey")
  @@map("purchase_items")
}

model Bill {
  id           String        @id @default(cuid())
  billNumber   String
  vendorId     String
  purchaseId   String?
  tenantId     String
  billDate     DateTime      @default(now())
  dueDate      DateTime
  subtotal     Decimal       @db.Decimal(15, 2)
  taxAmount    Decimal       @default(0.00) @db.Decimal(15, 2)
  totalAmount  Decimal       @db.Decimal(15, 2)
  paidAmount   Decimal       @default(0.00) @db.Decimal(15, 2)
  status       BillStatus    @default(PENDING)
  currency     String        @default("USD")
  exchangeRate Decimal       @default(1.000000) @db.Decimal(10, 6)
  notes        String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        BillItem[]
  payments     BillPayment[]
  purchase     Purchase?     @relation(fields: [purchaseId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor       Vendor        @relation(fields: [vendorId], references: [id])

  @@unique([tenantId, billNumber])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([purchaseId], map: "bills_purchaseId_fkey")
  @@index([vendorId], map: "bills_vendorId_fkey")
  @@map("bills")
}

model BillItem {
  id              String               @id @default(cuid())
  billId          String
  description     String
  quantity        Decimal              @db.Decimal(10, 3)
  unitPrice       Decimal              @db.Decimal(15, 2)
  totalPrice      Decimal              @db.Decimal(15, 2)
  taxRate         Decimal              @default(0.0000) @db.Decimal(5, 4)
  accountCode     String?
  tenantId        String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  inventoryItemId String?
  bill            Bill                 @relation(fields: [billId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem?       @relation(fields: [inventoryItemId], references: [id])
  costLayers      InventoryCostLayer[] @relation("BillItemCostLayer")

  @@index([tenantId, billId])
  @@index([billId], map: "bill_items_billId_fkey")
  @@index([inventoryItemId], map: "bill_items_inventoryItemId_fkey")
  @@map("bill_items")
}

model BillPayment {
  id              String         @id @default(cuid())
  billId          String
  amount          Decimal        @db.Decimal(15, 2)
  paymentDate     DateTime       @default(now())
  paymentMethod   String
  reference       String?
  notes           String?
  tenantId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  vendorPaymentId String?
  bill            Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  vendorPayment   VendorPayment? @relation("VendorPaymentBillPayments", fields: [vendorPaymentId], references: [id])

  @@index([tenantId, billId])
  @@index([billId], map: "bill_payments_billId_fkey")
  @@index([vendorPaymentId])
  @@map("bill_payments")
}

model Expense {
  id                   String         @id @default(cuid())
  description          String
  amount               Decimal        @db.Decimal(15, 2)
  expenseDate          DateTime       @default(now())
  category             String
  subcategory          String?
  receiptUrl           String?
  billable             Boolean        @default(false)
  customerId           String?
  projectId            String?
  status               ExpenseStatus  @default(PENDING)
  approvedBy           String?
  approvedAt           DateTime?
  tenantId             String
  userId               String
  metadata             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  branch               String?
  currency             String         @default("MMK")
  exchangeRate         Decimal        @default(1.0000) @db.Decimal(10, 4)
  expenseAccountId     String
  expenseNumber        String         @unique
  journalId            String?
  notes                String?
  paidAt               DateTime?
  paidThroughId        String?
  paidThroughAccountId String?
  receiptFiles         Json?
  reference            String?
  taxAmount            Decimal        @default(0.00) @db.Decimal(15, 2)
  taxRateId            String?
  totalAmount          Decimal        @db.Decimal(15, 2)
  vendorId             String?
  customer             Customer?      @relation(fields: [customerId], references: [id])
  expenseAccount       Account        @relation("ExpenseAccount", fields: [expenseAccountId], references: [id])
  paidThroughAccount   Account?       @relation("ExpensePaidThroughAccount", fields: [paidThroughAccountId], references: [id])
  paidThrough          PaymentMethod? @relation("PaidThroughPaymentMethod", fields: [paidThroughId], references: [id])
  taxRate              TaxRate?       @relation(fields: [taxRateId], references: [id])
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor               Vendor?        @relation(fields: [vendorId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, expenseDate])
  @@index([tenantId, expenseNumber])
  @@index([customerId], map: "expenses_customerId_fkey")
  @@index([vendorId], map: "expenses_vendorId_fkey")
