// ===== AI-ENHANCED MODELS =====

model AIInsight {
  id          String        @id @default(cuid())
  type        AIInsightType
  entityType  String        // 'invoice', 'expense', 'customer', 'vendor', 'transaction'
  entityId    String
  insight     Json          // Structured insight data
  confidence  Float         // AI confidence score (0.0 - 1.0)
  embedding   Bytes?        // Vector embedding for semantic search
  tags        Json?         // Semantic tags as JSON array: ['seasonal', 'recurring', 'anomaly', 'high_risk']
  metadata    Json?         // Additional context and parameters
  tenantId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@map("ai_insights")
}

model BusinessPattern {
  id           String   @id @default(cuid())
  patternType  String   // 'seasonal', 'recurring', 'growth', 'risk', 'anomaly'
  description  String
  pattern      Json     // Pattern definition and parameters
  confidence   Float    // Pattern strength (0.0 - 1.0)
  embedding    Bytes?   // Vector for pattern similarity matching
  frequency    String?  // 'daily', 'weekly', 'monthly', 'quarterly', 'yearly'
  isActive     Boolean  @default(true)
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId, patternType])
  @@index([tenantId, isActive])
  @@map("business_patterns")
}

model AIModel {
  id           String    @id @default(cuid())
  name         String    // 'cash_flow_predictor', 'expense_categorizer', 'anomaly_detector'
  type         String    // 'prediction', 'classification', 'anomaly', 'nlp'
  version      String    @default("1.0.0")
  parameters   Json      // Model configuration and hyperparameters
  performance  Json      // Accuracy, precision, recall metrics
  isActive     Boolean   @default(true)
  lastTrained  DateTime?
  tenantId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId, type, isActive])
  @@index([tenantId, name])
  @@map("ai_models")
}

model ConversationHistory {
  id           String   @id @default(cuid())
  sessionId    String   // User session identifier
  query        String   // User's natural language query
  intent       String?  // Detected intent: 'cash_flow', 'expenses', 'invoices', 'reports'
  response     Json     // AI response with data and insights
  confidence   Float    // Response confidence score
  feedback     String?  // User feedback: 'helpful', 'not_helpful'
  executionTime Int     // Response time in milliseconds
  tenantId     String
  userId       String?  // Optional user tracking
  createdAt    DateTime @default(now())
  
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId, sessionId])
  @@index([tenantId, intent])
  @@index([tenantId, createdAt])
  @@map("conversation_history")
}

model PredictionCache {
  id           String   @id @default(cuid())
  predictionType String // 'cash_flow', 'invoice_payment', 'expense_category'
  inputHash    String   // Hash of input parameters for cache matching
  prediction   Json     // Cached prediction result
  confidence   Float    // Prediction confidence
  expiresAt    DateTime // When this prediction expires
  tenantId     String
  createdAt    DateTime @default(now())
  
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, predictionType, inputHash])
  @@index([tenantId, expiresAt])
  @@map("prediction_cache")
}

enum AIInsightType {
  CASH_FLOW_PREDICTION
  ANOMALY_DETECTION
  PATTERN_RECOGNITION
  RISK_ASSESSMENT
  OPTIMIZATION_SUGGESTION
  CATEGORIZATION_CONFIDENCE
  PAYMENT_PREDICTION
  EXPENSE_ANALYSIS
  REVENUE_FORECAST
}
