{
  "name": "aibook",
  "version": "1.0.0",
  "description": "AI-First Bookkeeping SaaS with ALE Integration",
  "main": "dist/index.js",
  "_moduleAliases": {
    "@": "src",
    "@/types": "src/types",
    "@/services": "src/services",
    "@/models": "src/models",
    "@/controllers": "src/controllers",
    "@/middleware": "src/middleware",
    "@/utils": "src/utils"
  },
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "dev:setup": "./scripts/development/setup-environment.sh",
    "dev:backend": "./scripts/development/start-backend.sh",
    "dev:frontend": "cd frontend && PORT=3001 npm run dev",
    "dev:all": "./scripts/development/start-all.sh",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node -r tsconfig-paths/register src/utils/seedData.ts",
    "db:reset": "prisma migrate reset --force",
    "db:deploy": "prisma migrate deploy",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "accounting",
    "bookkeeping",
    "ai",
    "saas",
    "multi-tenant"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@google-cloud/aiplatform": "^5.0.0",
    "@google-cloud/bigquery": "^8.1.1",
    "@google-cloud/storage": "^7.16.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@types/kafkajs": "^1.8.2",
    "@types/redis": "^4.0.10",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-ledger": "^0.2.0",
    "openai": "^5.11.0",
    "redis": "^5.8.0",
    "zod": "^3.25.76",
    "normalize:tenant": "node scripts/normalize-tenant-id.js",
    "seed:baseline": "node scripts/seed-default-tenant-from-current.js"
  }
}
