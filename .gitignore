# Build artifacts and compiled files
dist/
build/
*.js.map
*.d.ts.map

# Dependency directories
node_modules/
frontend/node_modules/

# Cache directories
.next/
.nuxt/
.cache/

# Log files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output/

# Environment variables and configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Credentials and sensitive files
credentials/
*.key
*.pem
*.crt
*service-account*.json
.credentials/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
temp/
tmp/
test_*.json

# Database files
*.db
*.sqlite
*.sqlite3

# Redis dump files
dump.rdb

# Docker files (optional - remove if needed)
# Dockerfile
# docker-compose*.yml

# Test files in root (keep organized tests in tests/ folder)
test-*.js
*test*.js

# Backup files
*.bak
*.backup

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
public

# Storybook build outputs
.out
.storybook-out

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Ignore simple test files that shouldn't be in the repo
simple-*.js
simple-*.sql